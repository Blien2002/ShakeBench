recursive-include robosuite/controllers/config/ *
recursive-include robosuite/demos *
recursive-include robosuite/models/assets/ *
recursive-include robosuite/scripts *

# Phase 06/07 raw traces are release evidence and are verified only through
# an explicit external evidence archive.  Runtime profiles, compact manifests,
# meshes, textures, and small fixtures remain package-owned.
recursive-exclude robosuite/models/assets *raw*.json
recursive-exclude robosuite/models/assets *diagnostic*.json
recursive-exclude robosuite/models/assets *selected_diagnostics*.json
global-exclude __pycache__/*
global-exclude *.py[cod]
