        <geom name="battery" type="box" pos="0.005 -0.028 -0.057" size="0.041 0.026 0.012"
              group="0" rgba="0.5 0.5 0.5 0"/>
        <geom name="handle" type="box" pos="0.007 -0.027 -0.013" size="0.016 0.019 0.044"
              group="0" rgba="0.5 0.5 0.5 0"/>
        <geom name="motor" type="box" pos="0.014 -0.027 0.075" size="0.045 0.027 0.038"
              group="0" rgba="0.5 0.5 0.5 0"/>
        <geom name="chuck" type="capsule" fromto="-0.115 -0.027 0.075 -0.025 -0.027 0.075" size="0.016"
              group="0" rgba="0.5 0.5 0.5 0"/>
      </body>
      <site name="bottom_site" pos="0 0 -0.069" size="0.005" rgba="0 0 0 0"/>
      <site name="top_site" pos="0 0 0.113" size="0.005" rgba="0 0 0 0"/>
      <site name="horizontal_radius_site" pos="0.06 0 0" size="0.005" rgba="0 0 0 0"/>
    </body>
  </worldbody>
</mujoco>
